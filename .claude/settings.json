{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard_git.py\"",
            "timeout": 15,
            "statusMessage": "git guvenlik kontrolu"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/compile_check.py\"",
            "timeout": 30,
            "statusMessage": "compileall"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_start.py\"",
            "timeout": 30,
            "statusMessage": "proje durumu okunuyor"
          }
        ]
      }
    ]
  }
}
