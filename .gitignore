# Python cache and test cache
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# Build outputs
build/
dist/
installer_output/

# Temporary test/runtime folders
tmp/
temp/
test_tmp/
.tmp/
tests/tmp/
tests/.tmp/

# Runtime logs and local user settings
*.log
logs/
*.ini
*.qsettings

# Large third-party runtime binaries (tracked by checksum manifest only)
bin/mpv-2.dll
bin/libmpv.dll.a
bin/yt-dlp.exe
bin/deno.exe

# Replaced nonfree mpv build. Kept on disk because local use is fine; it must
# never be distributed and must never enter the repository.
bin/_old/

# Rejected icon drafts (3.1 MB). The product ships only
# assets/mlc-player-icon.png and .ico; the drafts stay on disk for
# reference but are not repository content.
assets/icon-concepts/

# The release signing private key NEVER enters the repository
# (see packaging/sign_release.py).
*.key
.mlcplayer/

# Compiled translations are build output; the `.ts` sources are tracked.
*.qm

# Agent-local settings: this file records absolute paths from the machine
# it was written on. The repository is public and its history was already
# rewritten once to strip a Windows user name, so it must never be added
# again. Do not rely on a global ignore rule for this - that rule does not
# travel with a clone.
.claude/settings.local.json

# Mirrored upstream source archives (GPLv3 corresponding source). Build
# output: fetched by packaging/fetch_sources.py and uploaded to the
# release, never tracked here.
source_mirror/
